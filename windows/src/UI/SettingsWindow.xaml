<Window x:Class="ParaphraseTool.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paraphrase Tool – Settings" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Server URL" FontWeight="SemiBold" />
        <TextBox x:Name="ServerBox" Margin="0,4,0,12" />

        <TextBlock Text="API key" FontWeight="SemiBold" />
        <PasswordBox x:Name="KeyBox" Margin="0,4,0,12" />

        <TextBlock Text="Paraphrase style" FontWeight="SemiBold" />
        <TextBox x:Name="StyleBox" Margin="0,4,0,12" Height="60" TextWrapping="Wrap" AcceptsReturn="True" />

        <CheckBox x:Name="StartupBox" Content="Start with Windows" Margin="0,0,0,16" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Width="80" IsDefault="True" Margin="0,0,8,0" Click="Save_Click" />
            <Button Content="Cancel" Width="80" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
