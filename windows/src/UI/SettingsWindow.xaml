<Window x:Class="ParaphraseTool.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paraphrase Tool – Settings" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Server URL" FontWeight="SemiBold" />
        <TextBox x:Name="ServerBox" Margin="0,4,0,12" />

        <TextBlock Text="API key" FontWeight="SemiBold" />
        <PasswordBox x:Name="KeyBox" Margin="0,4,0,12" />

        <TextBlock Text="Paraphrase instruction" FontWeight="SemiBold" />
        <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,0"
                   Text="Sent to the AI as the command for every paraphrase. Examples: Make it more formal · Shorter and punchier · Friendly and casual · Translate to English · Make it 3 bullet points" />
        <TextBox x:Name="StyleBox" Margin="0,6,0,12" Height="60" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="1000" />

        <CheckBox x:Name="StartupBox" Content="Start with Windows" Margin="0,0,0,12" />

        <TextBlock Margin="0,0,0,16">
            <Run Text="Repository: " Foreground="Gray" />
            <Hyperlink x:Name="RepoLink" NavigateUri="https://github.com/ferdinandimas/desktop-tools"
                       RequestNavigate="RepoLink_RequestNavigate">github.com/ferdinandimas/desktop-tools</Hyperlink>
        </TextBlock>

        <Grid>
            <TextBlock x:Name="VersionText" Foreground="Gray" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Width="80" IsDefault="True" Margin="0,0,8,0" Click="Save_Click" />
                <Button Content="Cancel" Width="80" IsCancel="True" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
